{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "src/components/canvas", "src/lib/textures.ts", "src/components/dom/HUDRail.tsx", "src/components/dom/SocialRail.tsx", "src/components/dom/Loader.tsx", "src/components/dom/CustomCursor.tsx", "src/components/dom/HeroOverlay.tsx", "src/components/dom/SectionOverlays.tsx", "src/components/dom/ImpactFlash.tsx"]
}
